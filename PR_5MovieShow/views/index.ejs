<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at top, #1a1a2e, #000);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
        }

        .app {
            width: 95%;
            max-width: 1000px;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            color: #ffcc00;
            letter-spacing: 1px;
        }

        .nav-link {
            margin-left: 25px;
            text-decoration: none;
            color: #bbb;
            font-size: 15px;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #ffcc00;
        }

        .app-title {
            text-align: center;
            font-size: 42px;
            background: linear-gradient(90deg, #ffcc00, #ff0066);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #aaa;
            margin-bottom: 40px;
            font-size: 15px;
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .glass-card h3 {
            text-align: center;
            font-size: 24px;
            margin-bottom: 25px;
            color: #ffcc00;
            letter-spacing: 0.5px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 13px;
            margin-bottom: 8px;
            color: #ccc;
        }

        .form-group input,
        .form-group textarea {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 14px;
            border-radius: 10px;
            outline: none;
            font-size: 14px;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #ffcc00;
            box-shadow: 0 0 12px rgba(255, 204, 0, 0.6);
        }

        textarea {
            resize: none;
            height: 100px;
        }

        .full {
            grid-column: span 2;
        }

        .primary-btn {
            padding: 16px;
            border-radius: 14px;
            border: none;
            font-size: 17px;
            font-weight: bold;
            color: #000;
            background: linear-gradient(135deg, #ffcc00, #ff0066);
            cursor: pointer;
            transition: 0.3s;
            letter-spacing: 0.5px;
        }

        .primary-btn:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 40px rgba(255, 0, 102, 0.6);
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .full {
                grid-column: span 1;
            }

            .app-title {
                font-size: 32px;
            }
        }
    </style>

</head>

<body>

    <div class="app">

        <header class="navbar">
            <div class="logo">🎥 CINEMA HUB</div>
            <nav>
                <a href="/" class="nav-link active">Add Movie</a>
                <a href="/add" class="nav-link">View Movies</a>
            </nav>
        </header>

        <h1 class="app-title">Movie Management</h1>
        <p class="subtitle">Create, manage and showcase movies like a pro</p>

        <div class="glass-card">

            <h3>Add New Movie</h3>

            <form action="/add-movie" method="post" enctype="multipart/form-data" class="form-grid">

                <div class="form-group">
                    <label>Movie Title</label>
                    <input type="text" name="title" placeholder="Eg. Inception" required>
                </div>

                <div class="form-group">
                    <label>Genre</label>
                    <input type="text" name="genre" placeholder="Action / Sci-Fi" required>
                </div>

                <div class="form-group full">
                    <label>Description</label>
                    <textarea name="description" placeholder="Story of the movie..." required></textarea>
                </div>

                <div class="form-group">
                    <label>Duration (Minutes)</label>
                    <input type="number" name="duration" placeholder="148" required>
                </div>

                <div class="form-group">
                    <label>Movie Poster</label>
                    <input type="file" name="movieImg">
                </div>

                <button class="primary-btn full">🎬 Publish Movie</button>

            </form>

        </div>

    </div>

</body>
</html>
