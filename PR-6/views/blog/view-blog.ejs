<%- include('../header') %>

<style>
    body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
    }

    .col-md-4 {
        display: flex;
    }

    .blog-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        transition: 0.3s ease;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        background: #ffffff;
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 35px rgba(0,0,0,0.15);
    }

    .blog-card img {
        height: 220px;
        object-fit: cover;
        transition: 0.4s ease;
    }

    .blog-card:hover img {
        transform: scale(1.05);
    }

    .blog-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: black;
        color: white;
        padding: 5px 15px;
        font-size: 12px;
        border-radius: 20px;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .blog-title {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .blog-meta {
        font-size: 13px;
        color: #888;
        margin-bottom: 10px;
    }

    .short-desc {
        font-size: 14px;
        font-weight: 500;
        color: #333;
        margin-bottom: 6px;
    }

    .full-desc {
        font-size: 13px;
        color: #777;
        margin-bottom: 10px;
        min-height: 60px;
        flex-grow: 1;
    }

    .read-btn {
        background: linear-gradient(45deg, #000, #444);
        color: white;
        border-radius: 30px;
        padding: 6px 20px;
        transition: 0.3s;
        font-size: 14px;
        border: none;
    }

    .read-btn:hover {
        background: linear-gradient(45deg, #222, #666);
        color: white;
    }

    .section-title {
        font-weight: bold;
        margin-bottom: 40px;
    }

    .blog-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .views {
        font-size: 13px;
        color: #888;
    }
</style>

<div class="container mt-5 mb-5">

    <h2 class="text-center section-title">📰 Latest Blogs</h2>

    <div class="row">
        <% blogs.forEach(blog => { %>
            <div class="col-md-4 mb-4">
                <div class="card blog-card">

                    <img src="/uploads/<%= blog.image %>" class="card-img-top">

                    <div class="blog-badge">
                        <%= blog.category %>
                    </div>

                    <div class="card-body p-4">

                        <h5 class="blog-title"><%= blog.title %></h5>

                        <div class="blog-meta">
                            By <strong><%= blog.author %></strong> • 
                            <%= new Date(blog.createdAt).toDateString() %>
                        </div>

                        <!-- Short Description -->
                        <div class="short-desc">
                            <%= blog.shortDesc %>
                        </div>

                        <!-- Full Description Preview -->
                        <div class="full-desc">
                            <%= blog.fullDesc.length > 100 
                                ? blog.fullDesc.substring(0, 100) + "..." 
                                : blog.fullDesc %>
                        </div>

                        <div class="blog-footer">
                            <a href="/blog/view/<%= blog._id %>" class="btn read-btn">
                                Read More →
                            </a>

                            <div class="views">
                                👁 <%= blog.views || 0 %> Views
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        <% }) %>
    </div>

</div>

<%- include('../footer') %>