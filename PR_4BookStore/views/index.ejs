<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #f5efe6, #faf7f2);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
        }

        .container-box {
            max-width: 1100px;
            margin: 50px auto
        }

        .card-ui {
            background: rgba(255, 255, 255, .95);
            backdrop-filter: blur(4px);
            border-radius: 22px;
            padding: 30px;
            box-shadow: 0 18px 45px rgba(120, 94, 70, .15);
            transition: .3s
        }

        .card-ui:hover {
            transform: translateY(-4px)
        }

        .title {
            font-weight: 600;
            letter-spacing: .6px;
            margin-bottom: 25px;
            color: #4b2e19
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px
        }

        .form-grid .full {
            grid-column: 1/3
        }

        label {
            font-size: 14px;
            font-weight: 500;
            color: #5c4033;
            margin-bottom: 6px
        }

        .form-control {
            border-radius: 12px;
            padding: 12px;
            border: 1px solid #d6c6b8
        }

        .form-control:focus {
            border-color: #b08968;
            box-shadow: 0 0 0 4px rgba(176, 137, 104, .25)
        }

        .btn-submit {
            background: linear-gradient(135deg, #8b5e3c, #6f4518);
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 14px;
            padding: 12px;
            letter-spacing: .6px
        }

        .btn-submit:hover {
            opacity: .9
        }

        .result-box {
            margin-top: 45px
        }

        .search-box {
            border-radius: 30px;
            padding: 10px 18px;
            border: 1px solid #d6c6b8
        }

        .table {
            overflow: hidden;
            border-radius: 16px
        }

        .table thead {
            background: linear-gradient(135deg, #8b5e3c, #6f4518);
            color: #fff
        }

        .table tbody tr {
            transition: .2s
        }

        .table tbody tr:hover {
            background: #f3e9dc
        }

        .book-img {
            width: 75px;
            height: 95px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 6px 14px rgba(111, 69, 24, .35)
        }

        .edit-btn {
            background: #c08552;
            color: #fff;
            padding: 6px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px
        }

        .edit-btn:hover {
            background: #a47148
        }

        .delete-btn {
            background: #b23a48;
            color: #fff;
            padding: 6px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px
        }

        .delete-btn:hover {
            background: #922b35
        }
    </style>


</head>

<body>

    <div class="container-box">

        <!-- ADD BOOK FORM -->
        <div class="card-ui">
            <h3 class="title text-center">📚 Add Book</h3>

            <form action="/add-book" method="post" enctype="multipart/form-data">
                <div class="form-grid">

                    <div>
                        <label>Title</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>

                    <div>
                        <label>Category</label>
                        <input type="text" name="category" class="form-control" required>
                    </div>

                    <div>
                        <label>Pages</label>
                        <input type="number" name="pages" class="form-control" required>
                    </div>

                    <div>
                        <label>Price</label>
                        <input type="number" name="price" class="form-control" required>
                    </div>

                    <div class="full">
                        <label>Book Image</label>
                        <input type="file" name="bookImg" class="form-control" required>
                    </div>

                    <div class="full">
                        <button class="btn-submit w-100">Add Book</button>
                    </div>

                </div>
            </form>
        </div>


        <!-- BOOK LIST -->
        <div class="result-box card-ui">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0">All Books</h4>
                <input class="form-control w-25" type="search" placeholder="Search">
            </div>

            <table class="table table-bordered align-middle text-center">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Pages</th>
                        <th>Price</th>
                        <th>Image</th>
                        <th colspan="2">Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% books.forEach((book, i)=>{ %>
                        <tr>
                            <td>
                                <%= i+1 %>
                            </td>
                            <td>
                                <%= book.title %>
                            </td>
                            <td>
                                <%= book.category %>
                            </td>
                            <td>
                                <%= book.pages %>
                            </td>
                            <td>₹ <%= book.price %>
                            </td>
                            <td><img src="<%= book.bookImg %>" class="book-img"></td>

                            <td>
                                <a href="/edit-book/<%= book._id%>" class="edit-btn">Edit</a>
                            </td>
                            <td>
                                <a href="/delete-book/<%= book._id%>" class="delete-btn">Delete</a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>

        </div>

    </div>

</body>

</html>